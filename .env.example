# Docker 배포용 예시입니다. 실제 비밀번호·키는 .env에만 입력하세요.
MYSQL_DATABASE=youth_policy
MYSQL_USER=youth_policy
MYSQL_PASSWORD=change_this_database_password
MYSQL_ROOT_PASSWORD=change_this_root_password
FLASK_SECRET_KEY=change_this_to_a_long_random_secret

# 실제 도메인을 사용할 때 https://example.com 형태로 입력하세요.
PUBLIC_BASE_URL=http://localhost:8080
KAKAO_REDIRECT_URI=http://localhost:8080/auth/kakao/callback
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=

# 선택 사항: AI 상담 / 이메일 알림
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
WEB_PORT=8080
