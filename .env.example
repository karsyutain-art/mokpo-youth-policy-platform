# 온통청년 마이페이지에서 발급받은 청년정책 API 키
YOUTHCENTER_POLICY_API_KEY=replace-with-your-key

# MySQL 8.0+ 연결 정보 (실제 값은 .env에만 저장)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=youth_policy
MYSQL_USER=root
MYSQL_PASSWORD=replace-with-your-password

# 카카오 로그인: 개발 중 Redirect URI는 http://localhost:5000/auth/kakao/callback
KAKAO_REST_API_KEY=replace-with-kakao-rest-api-key
KAKAO_CLIENT_SECRET=
FLASK_SECRET_KEY=replace-with-a-long-random-secret

# React + Vite / FastAPI 로컬 개발 주소
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000
KAKAO_REDIRECT_URI=http://localhost:5000/auth/kakao/callback
