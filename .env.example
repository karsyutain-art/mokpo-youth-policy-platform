# Docker 배포용 예시입니다. 실제 비밀번호·키는 .env에만 입력하세요.
POSTGRES_DB=youth_policy
POSTGRES_USER=youth_policy
POSTGRES_PASSWORD=change_this_database_password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=55432
POSTGRES_PORT_EXPOSE=55432
FLASK_SECRET_KEY=change_this_to_a_long_random_secret

# 실제 도메인을 사용할 때 https://example.com 형태로 입력하세요.
PUBLIC_BASE_URL=http://localhost:8080
KAKAO_REDIRECT_URI=http://localhost:8080/auth/kakao/callback
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
ADMIN_EMAILS=

# 선택 사항: AI 상담 / 이메일 알림
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true

# 웹 푸시 알림(아래 스크립트로 VAPID 키를 생성한 뒤 입력)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
# https 운영 도메인에서는 true로 설정합니다.
SESSION_HTTPS_ONLY=false
WEB_PORT=8080
